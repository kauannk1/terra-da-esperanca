{
  "name": "terra-da-esperanca",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "api:install": "cd backend && python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt",
    "api:init": "cd backend && . .venv/bin/activate && python -m app.db.init_db",
    "api:dev": "cd backend && . .venv/bin/activate && uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.60.0",
    "vite": "^7.0.0"
  }
}
